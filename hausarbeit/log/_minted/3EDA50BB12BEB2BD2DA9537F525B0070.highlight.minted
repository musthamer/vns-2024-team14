\begin{MintedVerbatim}[commandchars=\\\{\}]
          backend direct\PYGZhy{}backend
  http\PYGZhy{}request return status 200 content\PYGZhy{}type \PYGZdq{}text/plain\PYGZdq{} string \PYGZdq{}Moin from haproxy\PYG{k}{\PYGZbs{}n}\PYGZdq{}

backend app\PYGZhy{}backend
